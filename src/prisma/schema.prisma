generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id         String    @id @default(uuid())
  number     Int       @default(autoincrement())
  email      String    @unique
  password   String
  name       String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deleted_at DateTime?
  active     Boolean   @default(true)
  role       Role      @default(USER)
  urls       Urls[]

  @@index([email], name: "idx_users_email")
  @@map("users")
}

model Urls {
  id              String    @id @default(uuid())
  original_url    String
  shortener_url   String
  owner_id        String?
  owner           Users?    @relation(fields: [owner_id], references: [id])
  accesses_qty    Int       @default(0)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deleted_at      DateTime?
  active          Boolean   @default(true)
  previous_url_id String?
  previous_url    Urls?     @relation("url_versioning", fields: [previous_url_id], references: [id])
  next_versions   Urls[]    @relation("url_versioning")

  @@unique([original_url, owner_id], name: "uq_urls_original_per_owner")
  @@unique([shortener_url, owner_id], name: "uq_urls_shortener_url")
  @@index([shortener_url, owner_id], name: "idx_urls_shortener_url_owner_id")
  @@index([original_url, owner_id], name: "idx_urls_original_url_original_url")
  @@map("urls")
}

enum Role {
  USER
  ADMIN
}
